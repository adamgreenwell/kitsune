APP_NAME=Kitsune
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en

# SQLite by default: no database server, no credentials, no tuning.
# This is what makes the one-command install possible (ADR-026) and what
# keeps a small site inside the resource floor (ADR-027). Point this at
# pgsql or mysql when the site outgrows it.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=kitsune
# DB_USERNAME=kitsune
# DB_PASSWORD=

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Kitsune sends no telemetry, and there is no setting here to turn any on.
# That is a governance commitment, not a default (GOVERNANCE.md #7).
