APP_NAME=Kitsune
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en

# SQLite by default: no database server, no credentials, no tuning.
# This is what makes the one-command install possible (ADR-026) and what
# keeps a small site inside the resource floor (ADR-027). Point this at
# pgsql or mysql when the site outgrows it.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=kitsune
# DB_USERNAME=kitsune
# DB_PASSWORD=

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Mail. The floor sends none: `log` writes each message into
# storage/logs/laravel.log, which is where a developer finds a reader's
# sign-up or recovery link. Outside local and testing those two pages answer
# 503 until mail can reach a reader — a mailer that sends, and a sender
# address of your own (ADR-037). Signing in needs no mail. Reader mail goes
# out under each site's own name, from MAIL_FROM_ADDRESS.
MAIL_MAILER=log
# MAIL_HOST=127.0.0.1
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=hello@your-domain.example
# MAIL_FROM_NAME="${APP_NAME}"

# The shortest password a reader or the first owner may choose. Fifteen is
# the floor and no setting goes below it; raise it here, up to 64.
# KITSUNE_PASSWORD_MIN_CHARACTERS=15

# Kitsune sends no telemetry, and there is no setting here to turn any on.
# That is a governance commitment, not a default (GOVERNANCE.md #7).
