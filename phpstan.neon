includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6

    # Shipped code only.
    #
    # Pest's fluent expectation API (`expect(...)->not->toBeEmpty()`) resolves
    # `->not` dynamically, which PHPStan cannot see even with Pest's own
    # extension loaded. Analysing tests at level 6 therefore reports the most
    # common idiom in the suite as an error, and the only ways to silence it are
    # a growing baseline or writing tests to please the analyser rather than to
    # read well. Neither is worth it: tests are verified by running them.
    #
    # Revisit if a Pest-aware PHPStan extension covers expectation chaining.
    paths:
        - packages/core/src
        # The runbook's outside checks (issue #111). They are shipped code in the sense that matters
        # here: they run against a live server and decide whether it holds ADR-034's conditions, so a
        # null reaching a comparison is the difference between a verdict and a wrong verdict. They are
        # written in PHP rather than in a third language precisely so that this analyses them.
        - deploy/runbook/outside

    tmpDir: build/phpstan
